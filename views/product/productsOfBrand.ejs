<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kruger - Itens por Marca</title>
  <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <style>
    a{
      text-decoration: none;
      text-transform: none;
      color: black;
    }
  </style>



  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>

<header class="top-bar">
    <a href="/dashboard">
    <img src="/images/logo.png" alt="Krüger Embalagens" class="logo">
    </a>
  </div>

  <div class="user">
    <%= name %>
    <a style="color: white;" href="/users/logout">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</header>

<main class="container">
  <section class="filters">
    <h2>Itens da empresa: <h2><%= brand.name %></h2></h2>
    <button class="add-item">
      <a href="/product/add">
        <i class="bi bi-plus-circle"></i>
        Adicionar um item
      </a>
    </button>
  </section>

  <section class="items">
    <h2>Itens que não foram pedidos:</h2>

    <div class="items-header">
      <span>Descrição</span>
      <span>Restante</span>
      <span>Notificador</span>
      <span>Ações</span>
    </div>

    <% const orderedProducts = products.filter(p => p.ordered === true) %>
    <% const notOrderedProducts = products.filter(p => p.ordered === false) %>
    <% notOrderedProducts.forEach(p => { %>
    <div class="item">
        <span><%= p.name %></span>
        <span><%= p.quantity %></span>
        <span><%= p.identifier %></span>
        <div class="actions">
          <a href="/product/edit/<%= p.id %>">
            <button title="Editar">
                <i class="bi bi-pencil-square"></i>
            </button>
          </a>  
          <a href="/product/delete/<%= p.id %>">
            <button title="Excluir">
                <i class="bi bi-trash"></i>
            </button>
          </a>
       </div>
    </div>
    <% }) %>
  </section>

    <section class="items" style="margin-top: 30px;">
    <h2>Já pedidos:</h2>

    <div class="items-header">
      <span>Descrição</span>
      <span>Último Preço Pago</span>
      <span>Notificador</span>
      <span>Ações</span>
    </div>

    <% orderedProducts.forEach(p => { %>
    <div class="item">
        <span><%= p.name %></span>
        <span><%= p.lastPrice %></span>
        <span><%= p.identifier %></span>
        <div class="actions">
          <a href="/product/edit/<%= p.id %>">
            <button title="Editar">
                <i class="bi bi-pencil-square"></i>
            </button>
          </a>  
          <a href="/product/delete/<%= p.id %>">
            <button title="Excluir">
                <i class="bi bi-trash"></i>
            </button>
          </a>
       </div>
    </div>
    <% }) %>
  </section>


</main>

</body>
</html>
